# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.

LINEAR_CLIENT_ID=replace_me
LINEAR_CLIENT_SECRET=replace_me
LINEAR_REDIRECT_URI=http://localhost:3000/api/auth/linear/callback

# Anthropic API key for the LLM reasoning layer.
# Get one at https://console.anthropic.com/settings/keys (load $5 of credits first).
ANTHROPIC_API_KEY=replace_me

# Default model. Haiku is ~5x cheaper than Sonnet — fine for dev.
# Switch to claude-sonnet-4-6 for the YC demo.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
